      "text_source_bundle": "tabledata.ab",
      "rows": [
        {
          "id": "1",
          "buildingName": "家园大厅",
          "buildingDesc": "家园大厅是家园的中枢，升级家园大厅可以解锁更多的建筑物和提升建筑物等级上限。将角色入驻大厅可以租借给好友使用。",
          "npcName": "",
          "descTitles": "角色出租&&玩法说明"
        },
        {
          "id": "2",
          "buildingName": "作战室",
          "buildingDesc": "作战室是家园的指挥中心，家园的防御和掠夺均需要通过作战室来进行。掠夺其他玩家可以获得珍贵的精华资源。",
          "npcName": "",
          "descTitles": "作战阵容&&搜索对手&&家园掠夺&&玩法说明"
        },
        {
          "id": "3",
          "buildingName": "宝库",
          "buildingDesc": "宝库可保护精华资源，在您的家园被掠夺时，宝库可以对精华进行保护，减少被掠夺的数量。",
          "npcName": "宝库管理员",
          "descTitles": "玩法说明"
        },
        {
          "id": "4",
          "buildingName": "宿舍",
          "buildingDesc": "宿舍是提供给角色恢复体力的场所，将角色放置在宿舍中可以缓慢恢复体力。",
          "npcName": "宿舍管理员",
          "descTitles": "玩法说明"
        },
        {
          "id": "5",
          "buildingName": "酒馆",
          "buildingDesc": "酒馆",
          "npcName": "",
          "descTitles": ""
        },
        {
          "id": "6",
          "buildingName": "精华收集器",
          "buildingDesc": "精华收集器能生产精华，精华是生产其他道具的原材料。升级精华收集器能更快速的获取精华。",
          "npcName": "精华器工程师",
          "descTitles": "精华收集&&工作角色&&玩法说明"
        },
        {
          "id": "7",
          "buildingName": "蓝钻工坊",
          "buildingDesc": "蓝钻工坊是家园的道具生产建筑，可以产出蓝钻。升级蓝钻工坊可获得更多蓝钻。",
          "npcName": "钻石切割师",
          "descTitles": "生产订单&&订单说明&&工作角色&&玩法说明"
        },
        {
          "id": "8",
          "buildingName": "宝石工坊",
          "buildingDesc": "宝石工坊是家园的道具生产建筑，可以产出宝石。升级宝石工坊可获得更多宝石。",
          "npcName": "宝石雕刻师",
          "descTitles": "生产订单&&订单说明&&工作角色&&玩法说明"
        },
        {
          "id": "9",
          "buildingName": "精炼厂",
          "buildingDesc": "精炼厂是家园的道具生产建筑，可以产出精炼道具。升级精炼厂可获得更多道具。",
          "npcName": "精炼强化师",
          "descTitles": "生产订单&&订单说明&&工作角色&&玩法说明"
        },
        {
          "id": "10",
          "buildingName": "图书馆",
          "buildingDesc": "图书馆是家园的道具生产建筑，可以产出培养道具。升级图书馆可获得更多道具。",
          "npcName": "图书管理员",
          "descTitles": "生产订单&&订单说明&&工作角色&&玩法说明"
        },
        {
          "id": "11",
          "buildingName": "附魂殿",
          "buildingDesc": "附魂殿是家园的道具生产建筑，可以产出附魂券。升级附魂殿可获得更多附魂券。",
          "npcName": "附魂师",
